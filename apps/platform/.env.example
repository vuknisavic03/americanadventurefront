# Local development only. Copy this file to .env and replace the secret.
DATABASE_URL=postgresql://american_adventure:american_adventure@localhost:5432/american_adventure
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Zero ignores forwarding headers and safely groups unresolved clients together.
# Production must set the exact number of trusted reverse-proxy hops after the edge proxy is
# configured to append or overwrite X-Forwarded-For.
TRUSTED_PROXY_HOPS=0

# Optional machine-to-machine token for /api/operations/status. Use a distinct random secret with
# at least 32 characters in deployed environments; when absent the endpoint responds as not found.
# OBSERVABILITY_TOKEN=replace-with-a-separate-random-token

# Enable only after every public hostname and subdomain is permanently HTTPS-only.
SECURITY_ENABLE_HSTS=false

# Required before testing JMBG, passports, generated contracts, or other private documents.
# Generate two separate 32-byte base64 values as described in
# docs/runbooks/sensitive-data-local-setup.md. Never reuse production keys locally.
SENSITIVE_DATA_ACTIVE_KEY_ID=local-v1
SENSITIVE_DATA_ENCRYPTION_KEYS=local-v1:replace-with-32-random-bytes-in-base64
SENSITIVE_DATA_FINGERPRINT_KEY=replace-with-a-different-32-random-bytes-in-base64

# Candidate messages are captured locally and never leave the machine by default.
CANDIDATE_EMAIL_PROVIDER=capture
CANDIDATE_EMAIL_FROM=American Adventure <noreply@notify.workandtravel.rs>
CANDIDATE_EMAIL_REPLY_TO=beograd@workandtravel.rs
# Operations mailbox notified when a candidate submits or changes a flight-ticket request.
# The email contains only a protected admin link; request dates and destinations stay in the portal.
FLIGHT_REQUEST_NOTIFICATION_EMAIL=beograd@workandtravel.rs
CONSULTATION_BOOKING_URL=http://localhost:3000/konsultacije
# Optional until an external booking provider is selected. Enables the signed generic webhook.
# CONSULTATION_WEBHOOK_SECRET=replace-with-a-separate-random-secret
OFFICIAL_PHONE=+381 11 000 0000
PRIVACY_POLICY_URL=http://localhost:3000/politika-privatnosti
# RESEND_API_KEY is required only when CANDIDATE_EMAIL_PROVIDER=resend.

# SMS reminders are also captured locally by default. To deliver real messages, connect a trusted
# gateway that accepts the documented authenticated webhook contract. Never commit its token.
CANDIDATE_SMS_PROVIDER=capture
CANDIDATE_SMS_SENDER=AmAdventure
# CANDIDATE_SMS_WEBHOOK_URL=https://sms-provider.example/messages
# CANDIDATE_SMS_WEBHOOK_TOKEN=replace-with-a-separate-random-token

