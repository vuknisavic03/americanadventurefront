# Local automated tests only. Copy this file to .env.e2e.
DATABASE_URL=postgresql://american_adventure:american_adventure@localhost:5433/american_adventure_e2e
PAYLOAD_SECRET=e2e-local-secret-that-must-never-be-used-outside-tests
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3100
E2E_BASE_URL=http://127.0.0.1:3100
TRUSTED_PROXY_HOPS=1

# Tests capture messages in the database and never contact a real email provider.
CANDIDATE_EMAIL_PROVIDER=capture
FLIGHT_REQUEST_NOTIFICATION_EMAIL=beograd@workandtravel.rs
